# LLM Provider API Keys
# At least one provider must be configured.
# Generate real keys from the provider dashboard and set them in your .env file (gitignored)
# or as system environment variables.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Sarvam AI API Key (for STT / TTS voice features)
SARVAM_API_KEY=

# Microphone override for voice mode.
# Any substring of the device name (e.g. "Airdopes", "Realtek") or a device index.
# If unset, JARVIS auto-picks the loudest working input device.
JARVIS_MIC_DEVICE=Airdopes

# LLM Configuration
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini

# Personality
ACTIVE_PERSONALITY=jarvis

# --- Phase 4: Communication & Productivity ---

# Email (IMAP/SMTP). For Gmail use an App Password, not your login password.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# Optional: OpenWeatherMap / NewsAPI keys (graceful fallbacks exist without keys)
WEATHER_API_KEY=
NEWS_API_KEY=

# Twilio (phone calling via VoIP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Calendar OAuth2 (optional; local calendar works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Telegram (MTProto userbot via Telethon, not Bot API).
# Get api_id/api_hash at https://my.telegram.org. First run will ask for your phone
# number + login code; the session is persisted locally.
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=jarvis_telegram
# Comma-separated Telegram user ids allowed to talk to JARVIS (empty = no one).
TELEGRAM_ALLOWED_USERS=
# Chat id for proactive reminders / owner-only messages.
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_VOICE_ENABLED=true
